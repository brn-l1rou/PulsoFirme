rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function emailAtual() {
      return request.auth.token.email.lower();
    }

    function usuarioDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid));
    }

    function cuidadoresDe(pacienteId) {
      return usuarioDoc(pacienteId).data.get('cuidadoresAutorizados', []);
    }

    // RN04: só o próprio paciente ou cuidadores vinculados acessam os dados.
    function vinculadoAoPaciente(pacienteId) {
      return autenticado()
        && (request.auth.uid == pacienteId
          || request.auth.uid in cuidadoresDe(pacienteId));
    }

    match /usuarios/{userId} {
      // RF21: o e-mail só muda para o e-mail do login (já verificado
      // pelo Firebase Auth); tipo e data de criação nunca mudam.
      function camposImutaveisPreservados() {
        let alterados = request.resource.data.diff(resource.data).affectedKeys();
        return !alterados.hasAny(['tipoUsuario', 'criadoEm'])
          && (!alterados.hasAny(['email'])
            || request.resource.data.email == emailAtual());
      }

      // RN05: o cuidador só entra na lista do paciente se houver um convite
      // pendente criado pelo próprio paciente para o e-mail dele.
      function aceitandoConvite() {
        let convitePath = /databases/$(database)/documents/convites/$(userId + '_' + emailAtual());
        return exists(convitePath)
          && get(convitePath).data.status == 'pendente'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cuidadoresAutorizados'])
          && request.resource.data.cuidadoresAutorizados.toSet()
            == resource.data.get('cuidadoresAutorizados', []).toSet()
              .union([request.auth.uid].toSet());
      }

      // Desvincular: o paciente ou o cuidador pode tirar o próprio uid da
      // lista do outro (e nada além disso).
      function removendoProprioVinculo() {
        let alterados = request.resource.data.diff(resource.data).affectedKeys();
        let uid = request.auth.uid;
        return (alterados.hasOnly(['cuidadoresAutorizados'])
            && uid in resource.data.get('cuidadoresAutorizados', [])
            && request.resource.data.cuidadoresAutorizados.toSet()
              == resource.data.cuidadoresAutorizados.toSet().difference([uid].toSet()))
          || (alterados.hasOnly(['pacientesVinculados'])
            && uid in resource.data.get('pacientesVinculados', [])
            && request.resource.data.pacientesVinculados.toSet()
              == resource.data.pacientesVinculados.toSet().difference([uid].toSet()));
      }

      allow create: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.tipoUsuario in ['paciente', 'cuidador'];

      allow read: if autenticado()
        && (request.auth.uid == userId
          || request.auth.uid in resource.data.get('cuidadoresAutorizados', [])
          || request.auth.uid in resource.data.get('pacientesVinculados', []));

      allow update: if autenticado()
        && ((request.auth.uid == userId && camposImutaveisPreservados())
          || aceitandoConvite()
          || removendoProprioVinculo());

      allow delete: if false;
    }

    match /usuarios/{pacienteId}/medicoes/{medicaoId} {
      // RN06: valor numérico, positivo e válido; RN07: data obrigatória.
      function medicaoValida() {
        let d = request.resource.data;
        return d.valorMgdl is int
          && d.valorMgdl > 0
          && d.valorMgdl <= 1000
          && d.dataMedicao is timestamp
          && d.status in ['normal', 'acima', 'abaixo']
          // RF12/RF13: momento da medição e sintomas são opcionais.
          && (d.get('contexto', null) == null
            || d.contexto in ['jejum', 'pre_prandial', 'pos_prandial', 'antes_dormir'])
          && (d.get('sintomas', []) is list && d.get('sintomas', []).size() <= 10);
      }

      allow read: if vinculadoAoPaciente(pacienteId);

      allow create: if vinculadoAoPaciente(pacienteId)
        && medicaoValida()
        && request.resource.data.registradoPor == request.auth.uid;

      // RN11/RN12: paciente e cuidadores vinculados podem editar.
      allow update: if vinculadoAoPaciente(pacienteId)
        && medicaoValida()
        && request.resource.data.registradoPor == resource.data.registradoPor
        && request.resource.data.atualizadoPor == request.auth.uid;

      // RN13: cuidadores vinculados, ou o paciente sem cuidadores.
      allow delete: if autenticado()
        && (request.auth.uid in cuidadoresDe(pacienteId)
          || (request.auth.uid == pacienteId
            && cuidadoresDe(pacienteId).size() == 0));
    }

    // Foto de perfil: visível para quem pode ver o perfil (o próprio
    // usuário e quem está vinculado a ele); só o dono altera.
    match /usuarios/{userId}/publico/foto {
      function perfil() {
        return usuarioDoc(userId).data;
      }

      allow read: if autenticado()
        && (request.auth.uid == userId
          || request.auth.uid in perfil().get('cuidadoresAutorizados', [])
          || request.auth.uid in perfil().get('pacientesVinculados', []));

      // ~200 KB em base64 (a foto do app tem cerca de 30 KB).
      allow create, update: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.imagem is string
        && request.resource.data.imagem.size() <= 200000;

      allow delete: if autenticado() && request.auth.uid == userId;
    }

    // Tokens FCM do aparelho: só o dono lê e escreve (as Cloud Functions
    // usam o Admin SDK, que não passa pelas regras).
    match /usuarios/{userId}/tokens/{token} {
      allow read, write: if autenticado() && request.auth.uid == userId;
    }

    // RF08: log imutável, gravado junto com a medição (mesmo batch).
    match /usuarios/{pacienteId}/auditoria/{auditoriaId} {
      function medicaoPath() {
        return /databases/$(database)/documents/usuarios/$(pacienteId)/medicoes/$(request.resource.data.medicaoId);
      }

      allow read: if vinculadoAoPaciente(pacienteId);

      allow create: if vinculadoAoPaciente(pacienteId)
        && request.resource.data.uidResponsavel == request.auth.uid
        && request.resource.data.data == request.time
        && request.resource.data.acao in ['criacao', 'edicao', 'exclusao']
        && (request.resource.data.acao == 'exclusao'
          ? !existsAfter(medicaoPath())
          : existsAfter(medicaoPath()));

      allow update, delete: if false;
    }

    // RF14: medições programadas.
    match /usuarios/{pacienteId}/agendamentos/{agendamentoId} {
      function agendamentoValido() {
        let d = request.resource.data;
        return d.hora is string
          && d.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && d.frequencia in ['diaria', 'semanal', 'quinzenal']
          && (d.frequencia == 'diaria'
            || (d.diaSemana is int && d.diaSemana >= 1 && d.diaSemana <= 7))
          && d.toleranciaMinutos is int
          && d.toleranciaMinutos > 0
          && d.toleranciaMinutos <= 240
          && d.ativo is bool;
      }

      allow read, delete: if vinculadoAoPaciente(pacienteId);
      allow create, update: if vinculadoAoPaciente(pacienteId) && agendamentoValido();
    }

    // Alertas: o paciente só cria o SOS (RF06); "agendada" e "perdida" são
    // criados pelas Cloud Functions.
    match /usuarios/{pacienteId}/alertas/{alertaId} {
      allow read: if vinculadoAoPaciente(pacienteId);

      allow create: if autenticado()
        && request.auth.uid == pacienteId
        && request.resource.data.tipo == 'sos'
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time;

      allow update, delete: if false;
    }

    // RF05: remédios do paciente.
    match /usuarios/{pacienteId}/medicamentos/{medicamentoId} {
      function medicamentoValido() {
        let d = request.resource.data;
        return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80
          && d.dosagem is string && d.dosagem.size() > 0 && d.dosagem.size() <= 40
          && d.horarios is list && d.horarios.size() > 0 && d.horarios.size() <= 12
          && d.ativo is bool;
      }

      allow read, delete: if vinculadoAoPaciente(pacienteId);
      allow create, update: if vinculadoAoPaciente(pacienteId) && medicamentoValido();
    }

    // RF08: confirmação de dose, imutável e com quem confirmou.
    match /usuarios/{pacienteId}/tomadas/{tomadaId} {
      allow read: if vinculadoAoPaciente(pacienteId);

      allow create: if vinculadoAoPaciente(pacienteId)
        && request.resource.data.confirmadoPor == request.auth.uid
        && request.resource.data.data == request.time
        && exists(/databases/$(database)/documents/usuarios/$(pacienteId)/medicamentos/$(request.resource.data.medicamentoId));

      allow update, delete: if false;
    }

    // RN19: análise de padrões, escrita só pela Cloud Function.
    match /usuarios/{pacienteId}/insights/{insightId} {
      allow read: if vinculadoAoPaciente(pacienteId);
      allow write: if false;
    }

    // RF07: código de convite. Só o paciente cria e lê; o cuidador usa o
    // código pela Cloud Function "aceitarConvitePorCodigo".
    match /convitesCodigo/{codigo} {
      allow create: if autenticado()
        && codigo.matches('^[A-Z0-9]{6}$')
        && request.resource.data.pacienteId == request.auth.uid
        && request.resource.data.usado == false
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm < request.time + duration.value(8, 'd')
        && usuarioDoc(request.auth.uid).data.tipoUsuario == 'paciente';

      allow read, delete: if autenticado() && resource.data.pacienteId == request.auth.uid;
      allow update: if false;
    }

    match /convites/{conviteId} {
      function conviteDoPaciente() {
        let d = request.resource.data;
        return d.pacienteId == request.auth.uid
          && conviteId == request.auth.uid + '_' + d.emailCuidador
          && d.status == 'pendente'
          && usuarioDoc(request.auth.uid).data.tipoUsuario == 'paciente';
      }

      allow create: if autenticado() && conviteDoPaciente();

      allow read: if autenticado()
        && (resource.data.pacienteId == request.auth.uid
          || resource.data.emailCuidador == emailAtual());

      // O paciente pode reenviar um convite (volta para "pendente");
      // o cuidador convidado só pode aceitar ou recusar.
      allow update: if autenticado()
        && ((resource.data.pacienteId == request.auth.uid && conviteDoPaciente())
          || (resource.data.emailCuidador == emailAtual()
            && resource.data.status == 'pendente'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondidoEm'])
            && request.resource.data.status in ['aceito', 'recusado']));

      allow delete: if autenticado() && resource.data.pacienteId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
